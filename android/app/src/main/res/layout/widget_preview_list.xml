<?xml version="1.0" encoding="utf-8"?>
<!-- Today's schedule for the widget picker: widget_today with sample rows (row_event, row_section,
     row_todo) in the website's default colors. Keep it in step with the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_card" android:tint="@color/preview_line" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:background="@drawable/round_card" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/preview_scene" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" android:src="@drawable/desk_schedule" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/widget_label_today" android:textAllCaps="true" android:textColor="@color/preview_muted" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text="@string/preview_date" android:textColor="@color/preview_ink" android:textSize="19sp" />
            </LinearLayout>
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:padding="8dp" android:src="@drawable/ic_refresh" android:tint="@color/preview_muted" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_card" android:tint="@color/preview_line" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp">
                <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_bar" android:tint="@color/preview_accent" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:maxLines="1" android:paddingTop="1dp" android:text="09:30" android:textColor="@color/preview_accent" android:textSize="12sp" android:textStyle="bold" tools:ignore="HardcodedText" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:text="@string/preview_event_one" android:textColor="@color/preview_ink" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/preview_event_one_detail" android:textColor="@color/preview_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp">
                <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_bar" android:tint="@color/preview_accent" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:maxLines="1" android:paddingTop="1dp" android:text="12:30" android:textColor="@color/preview_accent" android:textSize="12sp" android:textStyle="bold" tools:ignore="HardcodedText" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:text="@string/preview_event_lunch" android:textColor="@color/preview_ink" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/preview_event_lunch_detail" android:textColor="@color/preview_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="5dp" android:paddingBottom="5dp">
                <ImageView android:layout_width="3dp" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_bar" android:tint="@color/preview_accent" />
                <TextView android:layout_width="52dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:maxLines="1" android:paddingTop="1dp" android:text="16:30" android:textColor="@color/preview_accent" android:textSize="12sp" android:textStyle="bold" tools:ignore="HardcodedText" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:text="@string/preview_event_two" android:textColor="@color/preview_ink" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="10dp" android:paddingBottom="4dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/desk_secretary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/section_todos" android:textColor="@color/preview_muted" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:layout_width="22dp" android:layout_height="wrap_content" android:text="✓" android:textColor="@color/preview_accent" android:textSize="13sp" android:textStyle="bold" tools:ignore="HardcodedText" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:text="@string/preview_todo_done" android:textColor="@color/preview_muted" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:layout_width="22dp" android:layout_height="wrap_content" android:text="○" android:textColor="@color/preview_accent" android:textSize="13sp" android:textStyle="bold" tools:ignore="HardcodedText" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:text="@string/preview_todo_one" android:textColor="@color/preview_ink" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="4dp">
                <TextView android:layout_width="22dp" android:layout_height="wrap_content" android:text="○" android:textColor="@color/preview_accent" android:textSize="13sp" android:textStyle="bold" tools:ignore="HardcodedText" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:text="@string/preview_todo_two" android:textColor="@color/preview_ink" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
