<?xml version="1.0" encoding="utf-8"?>
<!-- The Today widget for the widget picker: widget_checklist_small with a sample next routine in the
     website's default colors. Keep it in step with the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_card" android:tint="@color/preview_line" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:background="@drawable/round_card" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/preview_art" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="10dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:src="@drawable/desk_done" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/widget_label_today" android:textAllCaps="true" android:textColor="@color/preview_muted" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:maxLines="1" android:text="1/3" android:textColor="@color/preview_ink" android:textSize="20sp" tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>

        <!-- The progress bar: three segments, one done. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="8dp" android:layout_marginEnd="6dp">
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_pill" android:tint="@color/preview_accent" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_pill" android:tint="@color/preview_surface" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_pill" android:tint="@color/preview_surface" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:background="@drawable/round_tile" android:backgroundTint="@color/preview_surface" android:gravity="center_vertical" android:padding="8dp">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/check_box" android:tint="@color/preview_accent" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="2" android:text="@string/preview_routine_one" android:textColor="@color/preview_ink" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="@string/preview_routine_cadence" android:textColor="@color/preview_muted" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="match_parent" android:layout_height="40dp" />
    </LinearLayout>
</FrameLayout>
