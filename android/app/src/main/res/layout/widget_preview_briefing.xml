<?xml version="1.0" encoding="utf-8"?>
<!-- Briefings for the widget picker: widget_briefing with sample rows (row_heading, row_story) in the
     website's default colors. Keep it in step with the widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_card" android:tint="@color/preview_line" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="1dp" android:background="@drawable/round_card" android:clipToOutline="true" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/preview_art" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="10dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:importantForAccessibility="no" android:src="@drawable/ic_morning" android:tint="@color/preview_accent" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/briefing_label_gm" android:textAllCaps="true" android:textColor="@color/preview_muted" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text="@string/preview_date" android:textColor="@color/preview_ink" android:textSize="19sp" />
            </LinearLayout>
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:importantForAccessibility="no" android:padding="8dp" android:src="@drawable/ic_refresh" android:tint="@color/preview_muted" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/round_pill" android:backgroundTint="@color/preview_ink" android:gravity="center" android:maxLines="1" android:text="@string/briefing_morning" android:textColor="@color/preview_surface" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/round_pill" android:backgroundTint="@color/preview_wash" android:gravity="center" android:maxLines="1" android:text="@string/briefing_evening" android:textColor="@color/preview_ink" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/round_card" android:tint="@color/preview_line" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingEnd="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="3dp" android:background="@drawable/round_tile" android:backgroundTint="@color/preview_glass" android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/preview_briefing_greeting" android:textColor="@color/preview_ink" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:lineSpacingMultiplier="1.1" android:text="@string/preview_briefing_opening" android:textColor="@color/preview_muted" android:textSize="13sp" android:textStyle="italic" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="3dp" android:background="@drawable/round_tile" android:backgroundTint="@color/preview_glass" android:padding="10dp" android:fontFamily="serif" android:text="@string/preview_briefing_section" android:textColor="@color/preview_ink" android:textSize="17sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@drawable/round_tile" android:backgroundTint="@color/preview_glass" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="3" android:text="@string/preview_news_headline" android:textColor="@color/preview_ink" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:lineSpacingMultiplier="1.1" android:maxLines="3" android:text="@string/preview_news_summary" android:textColor="@color/preview_muted" android:textSize="13sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:text="@string/preview_news_source" android:textColor="@color/preview_accent" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="@drawable/round_tile" android:backgroundTint="@color/preview_glass" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="3" android:text="@string/preview_news_headline_two" android:textColor="@color/preview_ink" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:lineSpacingMultiplier="1.1" android:maxLines="3" android:text="@string/preview_news_summary_two" android:textColor="@color/preview_muted" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
