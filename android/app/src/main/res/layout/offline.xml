<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the WebView's own error page when the server can't be reached; styled after the website's maintenance page. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/offline_card"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/offline_secretary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.13"
                android:text="@string/offline_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityHeading="true"
                android:fontFamily="serif"
                android:text="@string/offline_title"
                android:textColor="@color/ink"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/offline_status"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/offline_body"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/offline_button"
                android:minWidth="128dp"
                android:minHeight="48dp"
                android:paddingHorizontal="20dp"
                android:stateListAnimator="@null"
                android:text="@string/offline_retry"
                android:textAllCaps="false"
                android:textColor="@color/background"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/offline_note"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
