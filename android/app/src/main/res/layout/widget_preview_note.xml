<?xml version="1.0" encoding="utf-8"?>
<!-- Quick note for the widget picker: widget_note with three earlier notes behind the front note, in
     the website's default colors. Keep it in step with the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="HardcodedText,UseAppTint">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="-10dp" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="-6dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/note_tab" android:tint="@color/preview_note_behind" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text="@string/preview_note_older_three" android:textColor="@color/preview_ink" android:textSize="13sp" android:textStyle="italic" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="07:30" android:textColor="@color/preview_muted" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="-6dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/note_tab" android:tint="@color/preview_note_back" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text="@string/preview_note_older_two" android:textColor="@color/preview_ink" android:textSize="13sp" android:textStyle="italic" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="08:12" android:textColor="@color/preview_muted" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="-6dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/note_tab" android:tint="@color/preview_note_behind" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="serif" android:maxLines="1" android:text="@string/preview_note_older" android:textColor="@color/preview_ink" android:textSize="13sp" android:textStyle="italic" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="08:57" android:textColor="@color/preview_muted" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:rotation="-1.5">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="3dp" android:layout_marginTop="12dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/note_shadow" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginEnd="2dp" android:layout_marginBottom="3dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/note_paper" android:tint="@color/preview_note" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginEnd="2dp" android:layout_marginBottom="3dp" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:letterSpacing="0.14" android:maxLines="1" android:text="@string/preview_note_when" android:textAllCaps="true" android:textColor="@color/preview_muted" android:textSize="10sp" android:textStyle="bold" />
                <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="8dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/round_circle" android:tint="@color/preview_ink" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_plus" android:tint="@color/preview_note" />
                </FrameLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="2dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="serif" android:lineSpacingExtra="3sp" android:text="@string/preview_note_text" android:textColor="@color/preview_ink" android:textSize="16sp" android:textStyle="italic" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no" android:src="@drawable/portrait_f1" />
                <TextView android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="6dp" android:background="@drawable/round_pill" android:backgroundTint="@color/preview_surface" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="9dp" android:paddingEnd="9dp" android:text="@string/note_state_local" android:textColor="@color/preview_muted" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginTop="8dp" android:background="@drawable/round_pill" android:backgroundTint="@color/preview_ink" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="@string/preview_note_sort" android:textColor="@color/preview_note" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
