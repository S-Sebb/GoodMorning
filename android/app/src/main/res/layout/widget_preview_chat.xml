<?xml version="1.0" encoding="utf-8"?>
<!-- Sample content for the widget picker; the real widget shows the owner's latest conversation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_title_default"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:text="@string/preview_reply"
        android:textColor="@color/ink"
        android:textSize="13sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end">
        <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingHorizontal="16dp" android:text="@string/chat_open" android:textColor="@color/sun" />
        <TextView android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/widget_button" android:gravity="center" android:minWidth="88dp" android:paddingHorizontal="20dp" android:text="@string/chat_ask" android:textColor="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>
