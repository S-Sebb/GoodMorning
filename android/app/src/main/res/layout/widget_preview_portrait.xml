<?xml version="1.0" encoding="utf-8"?>
<!-- Secretary for the widget picker: widget_portrait in the website's default colors. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint">

    <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:src="@drawable/round_circle" android:tint="@color/preview_wash" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:importantForAccessibility="no" android:src="@drawable/portrait_f1" />
    </FrameLayout>
</FrameLayout>
