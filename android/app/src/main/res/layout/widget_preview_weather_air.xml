<?xml version="1.0" encoding="utf-8"?>
<!-- Sample content for the widget picker, in the website's default colors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_card"
    android:orientation="vertical"
    android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/preview_card" android:backgroundTint="#EDF5EE" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:importantForAccessibility="no" android:src="@drawable/ic_leaf" android:tint="#387559" tools:ignore="UseAppTint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:letterSpacing="0.14" android:text="@string/weather_air" android:textAllCaps="true" android:textColor="#387559" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weather_aqi_good" android:textColor="#387559" android:textSize="22sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preview_weather_aqi" android:textColor="#387559" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
