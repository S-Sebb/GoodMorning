<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The daily update check waits for a network and stays scheduled after a restart. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Event reminders are exact alarms; a calendar reminder may use them. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Screen">

        <!-- The site is opened at the chosen server's /app; see Launcher.launchingUrl. -->
        <activity
            android:name=".Launcher"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The default server's links open in the app; other servers cannot be listed here. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="gm.love765.me" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ServerActivity"
            android:exported="false"
            android:label="@string/change_server"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WebActivity"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LinkActivity"
            android:exported="false"
            android:label="@string/link_title" />

        <activity
            android:name=".AskActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/AskDialog"
            android:windowSoftInputMode="adjustResize" />

        <!-- Its own task and no window, so a tick from the Today widget leaves the home screen as it is. -->
        <activity
            android:name=".RowActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Its own task, so opening a note from a widget never disturbs the website's screen. -->
        <activity
            android:name=".NoteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/widget_note_name"
            android:taskAffinity="me.love765.goodmorning.notes"
            android:theme="@style/NoteScreen"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <receiver android:name=".Widgets$Today" android:exported="false" android:label="@string/widget_today_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>
        <receiver android:name=".Widgets$Week" android:exported="false" android:label="@string/widget_week_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week" />
        </receiver>
        <receiver android:name=".Widgets$Chat" android:exported="false" android:label="@string/widget_chat_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_chat" />
        </receiver>
        <receiver android:name=".Widgets$Portrait" android:exported="false" android:label="@string/widget_portrait_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_portrait" />
        </receiver>
        <receiver android:name=".Widgets$Briefing" android:exported="false" android:label="@string/widget_briefing_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_briefing" />
        </receiver>
        <receiver android:name=".Widgets$News" android:exported="false" android:label="@string/widget_news_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_news" />
        </receiver>
        <receiver android:name=".Widgets$Weather" android:exported="false" android:label="@string/widget_weather_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_weather" />
        </receiver>
        <receiver android:name=".Widgets$WeatherFull" android:exported="false" android:label="@string/widget_weather_full_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_weather_full" />
        </receiver>
        <receiver android:name=".Widgets$Temperature" android:exported="false" android:label="@string/widget_temperature_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_temperature" />
        </receiver>
        <receiver android:name=".Widgets$Rain" android:exported="false" android:label="@string/widget_rain_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_rain" />
        </receiver>
        <receiver android:name=".Widgets$Air" android:exported="false" android:label="@string/widget_air_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_air" />
        </receiver>
        <receiver android:name=".Widgets$QuickNote" android:exported="false" android:label="@string/widget_note_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_note" />
        </receiver>
        <receiver android:name=".Reminders" android:exported="false" />

        <service
            android:name=".ListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service
            android:name=".SyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Also opened by the website's update pill through goodmorning://update. -->
        <activity
            android:name=".UpdateActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="goodmorning" android:host="update" />
            </intent-filter>
        </activity>

        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
