<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets tests/android talk to a local fake server and place widgets. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/debug_network">
        <!-- Its own task, so a hook never brings the app's pages back to the front. -->
        <activity android:name=".TestHooks" android:exported="true" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
