# Started on demand by goodmorning-account@.socket; exits after ten idle minutes.
# Install with a per-instance drop-in setting User/Group to the account's Linux UID.
[Unit]
Description=GoodMorning isolated agent %i
Requires=goodmorning-engine.service goodmorning-vault@%i.service goodmorning-account@%i.socket
After=goodmorning-engine.service goodmorning-vault@%i.service goodmorning-account@%i.socket
BindsTo=goodmorning-vault@%i.service

[Service]
Type=simple
Slice=goodmorning-accounts.slice
# Optional server-wide provider identifiers (MAL_CLIENT_ID); briefing_runtime forwards only named keys.
EnvironmentFile=-/etc/goodmorning/providers.env
ExecStart=/opt/goodmorning/python/bin/python /opt/goodmorning/current/scripts/goodmorning.py runtime --volume /srv/goodmorning/live/%i engine
Restart=on-failure
RestartSec=5
UMask=0077
LimitCORE=0
MemorySwapMax=0
MemoryMax=1536M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
# TMPDIR is not sufficient: libraries may write directly to /tmp or /var/tmp.
BindPaths=/srv/goodmorning/live/%i/tmp:/tmp /srv/goodmorning/live/%i/tmp:/var/tmp
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/goodmorning/live/%i
StandardOutput=null
StandardError=append:/srv/goodmorning/live/%i/tmp/engine-service.log
